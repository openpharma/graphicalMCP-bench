# R / RStudio
.Rhistory
.RData
.Rproj.user/
*.Rproj

# Scheduler job logs (LSF / Slurm)
logs/
*.out
*.err

# Large ad-hoc candidate dumps can be gigabytes.
*_full.rds

# Only scenario results (results/<id>/) are shared; ad-hoc runs without
# scenario= write directly into results/ and stay local.
results/*.rds
results/*.csv

# Intermediate job-array shards (merged into results/ by merge_shards=N).
results/shards/
results/*/shards/
