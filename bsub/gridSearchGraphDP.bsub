#!/bin/bash
# =============================================================================
# LSF submission script for scripts/gridSearchGraphDP.R
# =============================================================================
# Disjunctive-power twin of bsub/gridSearchGraphER.bsub. Same cluster mechanics;
# see that file for the ssh / revtunnel / shared-library notes.
#
# Submit with:   bsub < bsub/gridSearchGraphDP.bsub
# =============================================================================

#BSUB -J gogtDP_k4
#BSUB -n 64                       # total slots (cores) requested across nodes
#BSUB -R "span[ptile=16]"         # 16 cores/node -> 64/16 = 4 nodes
#BSUB -R "rusage[mem=4000]"       # MB per slot
#BSUB -q normal                   # <-- set to your queue
#BSUB -W 12:00                    # wall-clock limit HH:MM
#BSUB -o logs/gogtDP_k4.%J.out
#BSUB -e logs/gogtDP_k4.%J.err

set -euo pipefail

# --- Environment (adjust to your site) ---------------------------------------
module load R 2>/dev/null || true

cd "${LS_SUBCWD:-$PWD}"
mkdir -p logs results

export GOGT_ROOT="${GOGT_ROOT:-$PWD}"

# --- Run ---------------------------------------------------------------------
Rscript scripts/gridSearchGraphDP.R 0.90 0.80 0.70 0.60 \
  w_step=0.1 g_step=0.25 sim_n=10000 top_n=50 \
  allow_large_k=TRUE out_dir=results
